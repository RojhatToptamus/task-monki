{
  "name": "task-monki",
  "version": "0.2.0-alpha.2",
  "private": true,
  "license": "MIT",
  "description": "Experimental local task board for running AI coding agents in isolated Git worktrees.",
  "author": "Task Monki contributors",
  "homepage": "https://github.com/RojhatToptamus/task-monki#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RojhatToptamus/task-monki.git"
  },
  "bugs": {
    "url": "https://github.com/RojhatToptamus/task-monki/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1",
    "build:main": "tsc -p tsconfig.main.json && npm run build:preload",
    "build:tools": "tsc -p tsconfig.tools.json",
    "build:preload": "node scripts/build-preload.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "prepare:design-browser-runtime": "node scripts/prepare-design-browser-runtime.mjs",
    "dist:dir": "npm run prepare:design-browser-runtime && npm run build && electron-builder --dir",
    "dist:mac": "npm run prepare:design-browser-runtime -- --arch=arm64 --arch=x64 && npm run build && electron-builder --mac",
    "dist:mac:trusted": "electron-builder --mac dmg --arm64 --config electron-builder.release-mac.yml --publish never",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "verify:packaged-owned-process": "node scripts/verify-packaged-owned-process.mjs",
    "verify:packaged-preview": "node scripts/verify-packaged-preview-launcher.mjs",
    "verify:packaged-preview-safe-storage": "node scripts/verify-packaged-preview-safe-storage.mjs",
    "dev:api": "npm run build:tools && node dist-tools/dev/server.js",
    "dev:seed": "npm run build:tools && node dist-tools/dev/seed.js --reset",
    "test:agent-workflow": "npm run build:tools && node dist-tools/dev/agentTestWorkflow.js",
    "test:design-agent": "npm run build:tools && node dist-tools/dev/designAgentAcceptance.js",
    "smoke:providers": "npm run build:tools && node dist-tools/dev/providerSmoke.js",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --exclude \"**/NativeLauncherHost.integration.test.ts\" && vitest run src/core/preview/runtime/NativeLauncherHost.integration.test.ts",
    "test:focused": "vitest run --exclude \"**/*.integration.test.{ts,tsx}\" --exclude \"**/*.system.test.{ts,tsx}\"",
    "test:integration": "vitest run .integration.test.",
    "test:system": "vitest run .system.test.",
    "test:core": "vitest run src/core",
    "test:renderer": "vitest run src/renderer",
    "test:renderer:dom": "vitest run --config vitest.renderer.config.ts",
    "test:storage": "vitest run src/core/storage",
    "test:agent": "vitest run src/core/agent",
    "test:transport": "vitest run src/dev/devHttpServer.integration.test.ts src/electron src/renderer/api",
    "test:watch": "vitest",
    "check:architecture": "node scripts/check-architecture.mjs",
    "verify": "npm run check:themes && npm run typecheck && npm run check:architecture && npm test && npm run test:renderer:dom && npm run check:codex-protocol && npm run build",
    "generate:themes": "node tools/build-themes.mjs",
    "check:themes": "node tools/build-themes.mjs --check",
    "generate:codex-protocol": "node scripts/generate-codex-protocol.mjs",
    "check:codex-protocol": "node scripts/generate-codex-protocol.mjs --check",
    "test:preview-credential-gate": "sh scripts/preview-managed-credential-gate.sh",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "verify:packaged-runtime": "node scripts/verify-packaged-runtime.mjs",
    "verify:trusted-mac-release": "node scripts/verify-trusted-mac-release.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "^6.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@electron/osx-sign": "1.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "7zip-bin": "5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
